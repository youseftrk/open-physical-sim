<!-- Empty room collision shell: floor + four walls. Z-up, meters. -->
<worldbody>
  <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
  <geom name="floor" type="plane" size="3 3 0.05" rgba="0.75 0.75 0.78 1"
        friction="1 0.005 0.0001" condim="3"/>
  <!-- Walls (thin boxes) -->
  <geom name="wall_n" type="box" pos="0 3 1" size="3 0.05 1" rgba="0.85 0.85 0.9 1"/>
  <geom name="wall_s" type="box" pos="0 -3 1" size="3 0.05 1" rgba="0.85 0.85 0.9 1"/>
  <geom name="wall_e" type="box" pos="3 0 1" size="0.05 3 1" rgba="0.85 0.85 0.9 1"/>
  <geom name="wall_w" type="box" pos="-3 0 1" size="0.05 3 1" rgba="0.85 0.85 0.9 1"/>
</worldbody>
