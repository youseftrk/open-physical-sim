<!-- Includable fragment: actuators + arm body (no outer mujoco). -->
<default>
  <joint damping="0.5" armature="0.01"/>
  <geom contype="1" conaffinity="1" rgba="0.2 0.5 0.8 1"/>
  <motor ctrlrange="-2 2" ctrllimited="true"/>
</default>
<worldbody>
  <body name="base" pos="0 0 0.05">
    <geom name="base_geom" type="cylinder" size="0.08 0.05" rgba="0.3 0.3 0.35 1"
          mass="1.0"/>
    <body name="link1" pos="0 0 0.05">
      <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
      <geom name="link1_geom" type="capsule" fromto="0 0 0 0.25 0 0" size="0.03"
            mass="0.4"/>
      <body name="link2" pos="0.25 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1" range="-2.5 2.5"/>
        <geom name="link2_geom" type="capsule" fromto="0 0 0 0.2 0 0" size="0.025"
              mass="0.3"/>
        <geom name="ee" type="sphere" pos="0.2 0 0" size="0.03"
              rgba="0.9 0.3 0.2 1" mass="0.05"/>
      </body>
    </body>
  </body>
</worldbody>
<actuator>
  <motor name="shoulder_motor" joint="shoulder" gear="1"/>
  <motor name="elbow_motor" joint="elbow" gear="1"/>
</actuator>
